prefix_rule(pattern=["C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe", "-Command", "$gitProc = Start-Process -FilePath 'C:\\tools\\Git-Installer.exe' -ArgumentList '/VERYSILENT','/NORESTART','/SP-' -Wait -PassThru; if ($gitProc.ExitCode -ne 0) { throw \"Git 설치 실패: $($gitProc.ExitCode)\" }; $ghProc = Start-Process -FilePath 'msiexec.exe' -ArgumentList '/i','C:\\tools\\GitHubCLI-Installer.msi','/qn','/norestart' -Wait -PassThru; if ($ghProc.ExitCode -ne 0) { throw \"GitHub CLI 설치 실패: $($ghProc.ExitCode)\" }; Write-Output '설치 완료'"], decision="allow")
prefix_rule(pattern=["C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe", "-Command", "$release = Invoke-RestMethod -Uri 'https://api.github.com/repos/cli/cli/releases/latest' -Headers @{ 'User-Agent'='Codex-Installer' }; $asset = $release.assets | Where-Object { $_.name -match '^gh_.*_windows_amd64\\.zip$' } | Select-Object -First 1; if (-not $asset) { throw 'GitHub CLI ZIP을 찾지 못했습니다.' }; Invoke-WebRequest -Uri $asset.browser_download_url -OutFile 'C:\\tools\\GitHubCLI.zip'; Expand-Archive -LiteralPath 'C:\\tools\\GitHubCLI.zip' -DestinationPath 'C:\\tools\\GitHubCLI' -Force; $ghExe = Get-ChildItem -LiteralPath 'C:\\tools\\GitHubCLI' -Recurse -Filter 'gh.exe' | Select-Object -First 1; if (-not $ghExe) { throw 'gh.exe를 찾지 못했습니다.' }; $ghDir = $ghExe.DirectoryName; $userPath = [Environment]::GetEnvironmentVariable('Path','User'); if (($userPath -split ';') -notcontains $ghDir) { [Environment]::SetEnvironmentVariable('Path',(($userPath.TrimEnd(';') + ';' + $ghDir).TrimStart(';')),'User') }; Write-Output $ghExe.FullName; & $ghExe.FullName --version"], decision="allow")
